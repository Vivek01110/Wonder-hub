<% layout('/layouts/boilerplate') %>


<body>
    <div class="row mt-5">
        <div class= 'col-6 offset-2'>
            <form action="/signup" method="POST" class = "col-8 needs-validation" novalidate>
                <label for="username" class="form-label mt-3">Username</label>
                <input 
                    type="text"
                    name = "username"
                    placeholder = "Username"
                    class="form-control"
                    required />

                <label for="email" class="form-label">Email</label>
                <input 
                    type="email"
                    name = "email"
                  
                    placeholder = "email"
                    class="form-control"
                    required/>

                <label for="password" class="form-label">password</label>
                <input 
                    type="password"
                    name = "password"
                    placeholder = "password"
                    class="form-control"
                    required />

                <button class = 'btn btn-success'>Register</button>
            </form>

        </div>

    </div>
</body>


